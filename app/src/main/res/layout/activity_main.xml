<?xml version="1.0" encoding="utf-8"?>
<com.gtlauncher.app.DragLayer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============ LAYAR UTAMA ============ -->
    <LinearLayout
        android:id="@+id/homeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />

            <!-- Bilah mode edit -->
            <LinearLayout
                android:id="@+id/editBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/editWidget"
                    style="@style/EditBarButton"
                    android:text="+ Widget" />

                <TextView
                    android:id="@+id/editSettings"
                    style="@style/EditBarButton"
                    android:text="Pengaturan" />

                <TextView
                    android:id="@+id/editLock"
                    style="@style/EditBarButton"
                    android:text="Kunci" />

                <TextView
                    android:id="@+id/editDone"
                    style="@style/EditBarButton"
                    android:text="Selesai"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Titik penunjuk halaman -->
        <LinearLayout
            android:id="@+id/pageDots"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- Dock kaca -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dock"
            android:gravity="center"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="16dp" />
    </LinearLayout>

    <!-- ============ PUSTAKA APLIKASI ============ -->
    <LinearLayout
        android:id="@+id/drawerLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/drawer_scrim"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/drawer_title"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_search"
            android:hint="@string/hint_search"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white_soft"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

</com.gtlauncher.app.DragLayer>
