<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============ LAYAR UTAMA ============ -->
    <LinearLayout
        android:id="@+id/homeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Widget jam bergaya kaca -->
        <LinearLayout
            android:id="@+id/widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_widget"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="18dp">

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textAllCaps="true"
                android:textColor="@color/white_soft"
                android:textSize="13sp" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="68sp" />
        </LinearLayout>

        <!-- Halaman Layar Utama (Multi-halaman geser horizontal) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/homePager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:overScrollMode="never" />

        <!-- Indikator titik halaman -->
        <com.gtlauncher.app.PageIndicatorDotsView
            android:id="@+id/pageIndicator"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginVertical="2dp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/hint_swipe"
            android:textColor="@color/white_soft"
            android:textSize="12sp" />

        <!-- Dock kaca -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_dock"
            android:gravity="center"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="16dp" />
    </LinearLayout>

    <!-- ============ PUSTAKA APLIKASI ============ -->
    <LinearLayout
        android:id="@+id/drawerLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/drawer_scrim"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/drawer_title"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_search"
            android:hint="@string/hint_search"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white_soft"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>

</FrameLayout>
