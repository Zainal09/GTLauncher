<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/badgeDelete"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="-4dp"
            android:background="@drawable/bg_badge_delete"
            android:contentDescription="Hapus"
            android:padding="5dp"
            android:src="@drawable/ic_minus"
            android:visibility="gone" />

        <TextView
            android:id="@+id/appBadge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="-4dp"
            android:background="@drawable/bg_badge_count"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingHorizontal="5dp"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/appCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-2dp"
            android:layout_marginEnd="-4dp"
            android:background="@drawable/bg_check"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="2dp"
        android:shadowColor="#80000000"
        android:shadowRadius="4"
        android:textColor="@color/white"
        android:textSize="11sp" />
</LinearLayout>
